# ---- Database ----
# SQLite — a single local file, created automatically on first run. No
# database server to install.
DATABASE_URL=sqlite+aiosqlite:///./nextround.db

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Gemini API (Google AI Studio) — free, no billing required ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-free-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Code execution ----
# Per-test-case timeout in seconds for locally-run submissions
CODE_EXEC_TIMEOUT_SECONDS=8

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173
